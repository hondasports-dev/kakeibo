VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-frontend-api-url.clerk.accounts.dev
E2E_CLERK_USER_EMAIL=codex+clerk_test@example.com
E2E_CLERK_USER_PASSWORD=change-me

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=dev:your-deployment
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# CONVEX_DEPLOY_KEY は Vercel Production 環境のみに設定する (ローカルでは不要)
# Convex Dashboard > Deployment Settings > Generate Production Deploy Key
