VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-frontend-api-url.clerk.accounts.dev
E2E_CLERK_USER_EMAIL=codex+clerk_test@example.com
E2E_CLERK_USER_PASSWORD=change-me

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=dev:your-deployment
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

# E2E テストデータクリーンアップ用
# E2E_CLEANUP_SECRET は Convex Dashboard の同名環境変数と同じ値を設定する
# E2E_CLERK_USER_ID は Clerk Dashboard で確認したテストユーザーの tokenIdentifier
E2E_CLEANUP_SECRET=change-me
E2E_CLERK_USER_ID=https://your-clerk-frontend-api-url.clerk.accounts.dev|user_xxxxxx

# CONVEX_DEPLOY_KEY は Vercel Production 環境のみに設定する (ローカルでは不要)
# Convex Dashboard > Deployment Settings > Generate Production Deploy Key

# レシート画像抽出 (Convex 環境変数として設定する。.env.local には不要)
# pnpm exec convex env set RECEIPT_IMAGE_EXTRACTOR_MODE mock
# pnpm exec convex env set APP_ENV development
# OPENAI_API_KEY は production deployment のみに設定する
# pnpm exec convex env set OPENAI_API_KEY sk-...
