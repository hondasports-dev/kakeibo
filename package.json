{
  "name": "kakeibo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "preview": "vite preview",
    "test": "vitest",
    "prepare": "husky",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test --grep @smoke",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "clerk:login": "clerk auth login",
    "convex:dev": "convex dev"
  },
  "dependencies": {
    "@clerk/react": "^6.7.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.0.1",
    "convex": "^1.39.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.0",
    "valibot": "^1.4.0"
  },
  "devDependencies": {
    "@clerk/testing": "^2.0.33",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "chrome-devtools-mcp": "^0.25.0",
    "clerk": "^1.1.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.5",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "vercel": "^54.4.1",
    "vite": "^8.0.12",
    "vitest": "^4.1.7"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint",
      "oxfmt --check"
    ],
    "*.{json,md,css}": [
      "oxfmt --check"
    ]
  },
  "packageManager": "pnpm@11.1.2"
}
