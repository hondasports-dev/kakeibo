{
  "name": "Suzumemo",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt .loop/process.yaml .loop/templates/task-state.yaml && git diff -- .loop/process.yaml .loop/templates/task-state.yaml && exit 1",
    "preview": "vite preview",
    "pretest": "node scripts/check-test-environment.mjs",
    "test": "vitest --maxWorkers=4",
    "test:preflight": "node scripts/check-test-environment.mjs --coverage",
    "test:coverage": "node scripts/run-coverage.mjs",
    "prepare": "husky",
    "e2e": "node scripts/sync-e2e-env.mjs && playwright test",
    "e2e:env-sync": "node scripts/sync-e2e-env.mjs",
    "e2e:smoke": "node scripts/sync-e2e-env.mjs && playwright test --grep @smoke",
    "e2e:public": "node scripts/sync-e2e-env.mjs && playwright test --grep @public",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "clerk:login": "clerk auth login",
    "convex:dev": "convex dev",
    "line:rich-menu": "tsx scripts/apply-line-rich-menu.ts",
    "test:email-integration": "vitest run -c vitest.integration.config.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.16.6",
    "@clerk/react": "^6.14.5",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@mui/x-charts": "^9.11.1",
    "@mui/x-date-pickers": "^9.11.0",
    "convex": "^1.44.0",
    "dayjs": "^1.11.21",
    "framer-motion": "^12.42.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-email": "6.9.2",
    "react-router-dom": "^7.18.2",
    "resend": "6.18.1",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.6",
    "@edge-runtime/vm": "5.0.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "chrome-devtools-mcp": "^1.7.0",
    "clerk": "^2.2.0",
    "convex-test": "0.0.56",
    "dotenv": "^17.4.2",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "tailwindcss": "^4.3.2",
    "tsx": "4.23.12",
    "typescript": "~7.0.2",
    "vercel": "^59.5.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint",
      "oxfmt --check"
    ],
    "*.{json,css}": [
      "oxfmt --check"
    ]
  },
  "engines": {
    "node": "^24.18.0"
  },
  "packageManager": "pnpm@11.1.2"
}
